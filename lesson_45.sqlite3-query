SELECT posts.id, posts.title, posts.slug, categories.name AS category_name
FROM posts
JOIN categories ON posts.category_id = categories.id;

SELECT posts.id, posts.title, posts.slug, hashtags.name AS hashtag_name
FROM posts
JOIN posts_hashtags ON posts.id = posts_hashtags.post_id
JOIN hashtags ON posts_hashtags.hashtag_id = hashtags.id;


SELECT posts.id, posts.title, posts.slug, GROUP_CONCAT(hashtags.name) AS hashtags
FROM posts
JOIN posts_hashtags ON posts.id = posts_hashtags.post_id
JOIN hashtags ON posts_hashtags.hashtag_id = hashtags.id
GROUP BY posts.id;


SELECT posts.id, posts.title, posts.slug, categories.name AS category_name, categories.slug AS category_slug, GROUP_CONCAT(hashtags.name) AS hashtags, GROUP_CONCAT(hashtags.slug) AS hashtags_slugs
FROM posts
JOIN categories ON posts.category_id = categories.id
JOIN posts_hashtags ON posts.id = posts_hashtags.post_id
JOIN hashtags ON posts_hashtags.hashtag_id = hashtags.id
GROUP BY posts.id;