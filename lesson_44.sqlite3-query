PRAGMA foreign_keys = OFF;
-- проверим статус внешнего ключа проверки (включена или нет)
PRAGMA foreign_keys;

UPDATE posts
SET category_id = 66
WHERE id = 6;


SELECT *
FROM posts;

PRAGMA foreign_keys = ON;

