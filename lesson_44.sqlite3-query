-------- 3. Работа с таблицей категорий

-- Создаем таблицу categories - все названия лежат в этой таблице и это избавляет от потенциальных аномалий при работе с постами и их категориями



CREATE TABLE IF NOT EXISTS categories (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL UNIQUE,
    slug TEXT NOT NULL UNIQUE
);

INSERT INTO categories (name, slug)
VALUES 
    ('Python', 'python'),
    ('Базы данных', 'databases'),
    ('Инструменты', 'tools');

SELECT id, name, slug 
FROM categories 
ORDER BY id;

-- Добавляем внешний ключ в таблицу с постами - ссылку на категорию, по уаделению выставлять NULL, по обновлению менять на новое значение

ALTER TABLE posts
ADD COLUMN category_id 
    INTEGER
    REFERENCES categories(id)
    ON DELETE SET NULL
    ON UPDATE CASCADE;

-- Смотрю на все свои посты 
SELECT *
FROM posts;


