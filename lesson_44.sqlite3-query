---- 5. Базовые выборки с использованием JOIN

-- Все посты с их категориями
SELECT p.id, p.title, c.name AS category_name
FROM posts p
-- Посты могут быть и без категории (тоже покажем)
LEFT JOIN categories c ON p.category_id = c.id
ORDER BY p.id;

-- Все посты одной категории (например, Базы данных)
SELECT p.id, p.title, c.name AS category_name
FROM posts p
JOIN categories c ON p.category_id = c.id
WHERE c.name = 'Базы данных'
ORDER BY p.id;

-- 6. CUD - создание, обновление, удаление

-- Создать новый пост с категорией Python
INSERT INTO posts (title, content, category_id)
VALUES ('Python 3.15 в пути!', 'Кажется это шедевррр!', 1);

-- Обновить пост 7, поменять content
UPDATE posts
SET content = 'Кажется это шедевррррр??!'
WHERE id = 7;

-- поискать все посты про пайтон через LIKE по title и content
SELECT p.id, p.title, p.content, c.name AS category_name
FROM posts p
LEFT JOIN categories c ON p.category_id = c.id
WHERE p.title LIKE '%Python%' OR p.content LIKE '%Python%'
ORDER BY p.id;

