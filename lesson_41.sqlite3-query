SELECT mc.name, mc.APPEARANCES, hc.color, ec.color
FROM MarvelCharacters AS mc
CROSS JOIN HairColor AS hc
CROSS JOIN EyeColor AS ec
WHERE mc.APPEARANCES > 100 AND mc.name LIKE "Spider-Man (Peter Parker)"
ORDER BY mc.APPEARANCES DESC;
    
SELECT count(*)
FROM MarvelCharacters AS mc
CROSS JOIN HairColor AS hc
CROSS JOIN EyeColor AS ec
ORDER BY mc.APPEARANCES DESC;



