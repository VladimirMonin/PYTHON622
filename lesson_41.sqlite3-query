-- JOINS в SQLite 
-- JOIN он же INNER JOIN - объединяет строки из двух таблиц, когда выполняется условие соединения. (внешний ключ не NULL!)

SELECT mc.name, mc.APPEARANCES, ec.color
FROM MarvelCharacters AS mc
JOIN EyeColor AS ec ON mc.eye_id = ec.eye_id;

-- 6609 позиций (потеряли 10000 примерно из за того что в MarvelCharacters есть NULL в eye_id)

-- А что если мы добавим цвет волос сюда еще?)
-- 6298
SELECT mc.name, mc.APPEARANCES, ec.color, hc.color
FROM MarvelCharacters AS mc
JOIN EyeColor AS ec ON mc.eye_id = ec.eye_id
JOIN HairColor AS hc ON mc.hair_id = hc.hair_id;


-- LEFT JOIN - объединяет все строки из левой таблицы и соответствующие строки из правой таблицы. Если нет соответствующих строк в правой таблице, результат будет содержать NULL для правой таблицы.
SELECT mc.name, mc.APPEARANCES, ec.color, hc.color
FROM MarvelCharacters AS mc
LEFT JOIN EyeColor AS ec ON mc.eye_id = ec.eye_id
LEFT JOIN HairColor AS hc ON mc.hair_id = hc.hair_id;

-- все 16376 позиций на месте! Правда не у всех есть указанный цвет глаз и волос, поэтому там NULL

