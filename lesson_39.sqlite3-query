-- 3.0 Группировка по Align, а так же по identity - поможет понять сколько персонажей с разными идентичностями и характеристиками Align
SELECT ALIGN, identify, COUNT(*) AS character_count
FROM MarvelCharacters
WHERE ALIGN IS NOT NULL AND identify IS NOT NULL
GROUP BY ALIGN, identify
HAVING character_count > 9
ORDER BY ALIGN, character_count DESC;


-- 3.1 sex и identify - увидим сколько персонажей с разными идентичностями и характеристиками по полу
SELECT SEX, COUNT(*) as character_count
FROM MarvelCharacters
WHERE SEX IS NOT NULL
GROUP BY SEX
ORDER BY character_count DESC;


SELECT SEX, identify, COUNT(*) AS character_count
FROM MarvelCharacters
WHERE SEX IS NOT NULL AND identify IS NOT NULL
GROUP BY SEX, identify
-- HAVING character_count > 9
ORDER BY SEX, character_count DESC;



SELECT SEX, identify, COUNT(*) AS character_count, ROUND(AVG(APPEARANCES), 2) AS average_appearances, SUM(APPEARANCES) AS total_appearances
FROM MarvelCharacters
WHERE SEX IS NOT NULL AND identify IS NOT NULL
GROUP BY SEX, identify
-- HAVING character_count > 9
ORDER BY SEX, character_count DESC;


SELECT SEX, identify, COUNT(*) AS character_count, ROUND(AVG(APPEARANCES), 2) AS average_appearances, SUM(APPEARANCES) AS total_appearances
FROM MarvelCharacters
WHERE SEX IS NOT NULL 
AND identify IS NOT NULL
AND APPEARANCES > 9
GROUP BY SEX, identify
-- HAVING character_count > 9
ORDER BY SEX, character_count DESC;


