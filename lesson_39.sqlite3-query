SELECT year, COUNT(*) AS charecters_count
FROM MarvelCharacters
WHERE year IS NOT NULL
GROUP BY year
ORDER BY year;

SELECT year, COUNT(*) AS charecters_count
FROM MarvelCharacters
WHERE year IS NOT NULL
GROUP BY year
ORDER BY charecters_count DESC
LIMIT 10;

-- Группировка по декадам (по десятилетиям)

-- 1946 / 10 = 194.6 => 194 * 10 = 1940
-- 1982 / 10 = 198.2 => 198 * 10 = 1980
SELECT (year / 10) * 10 AS decade, COUNT(*) AS characters_count
FROM MarvelCharacters
WHERE year IS NOT NULL
GROUP BY decade
ORDER BY decade;


-- Один: сделать группировку по ALIVE, чтобы собрать группы живых и неживых персонажей, посчитать их количество.
SELECT ALIVE, COUNT(*) AS character_count
FROM MarvelCharacters
WHERE ALIVE IS NOT NULL
GROUP BY ALIVE;
 
-- Два: в предыдущий запрос добавить среднее количество появлений, округлённое до двух.
SELECT ALIVE, COUNT(*) AS character_count, ROUND(AVG(APPEARANCES), 2) AS average_appearances
FROM MarvelCharacters
WHERE ALIVE IS NOT NULL
GROUP BY ALIVE;