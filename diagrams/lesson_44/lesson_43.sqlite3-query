-- 13. Ошибка, которую полезно увидеть: обязательный столбец без значения.
-- Выполните отдельным выделенным запросом и прочитайте сообщение базы.
-- INSERT INTO posts (content) VALUES ('Заголовка нет.');
-- Ожидаем NOT NULL constraint failed: posts.title


-- 14. Найдем дубли. Сделаем группировку по заголовку и посчитаем количество повторов.
SELECT title, COUNT(*) AS count
FROM posts
GROUP BY title
ORDER BY count DESC;

-- 15. Найдем рецидивистов )) Что такое SQLite
SELECT *
FROM posts
WHERE title = 'Что такое SQLite';

-- 16. Обновим количество лайков и просмотров для поста с id = 5
UPDATE posts
SET likes = likes + 1, views = views + 10, content = 'Пост будет удален'
WHERE id = 5;

-- 17. Проверим, что обновление прошло успешно
SELECT * FROM posts WHERE id = 5;

-- 18. Удалим пост с id = 5
DELETE FROM posts WHERE id = 5;