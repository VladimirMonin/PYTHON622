-- 01. Список пользовательских таблиц в текущей базе.
-- В новой базе результат пустой: таблиц ещё нет, а файл уже существует.

SELECT name
FROM sqlite_schema
WHERE type = 'table';

-- 02. Все объекты базы: таблицы, индексы, представления.
SELECT name, type, tbl_name
FROM sqlite_schema
ORDER BY type, name;

-- Типы данных SQLite
-- NULL - отсутствие значения
-- INTEGER - целое число (1, 2, 3, ...)
-- REAL - число с плавающей точкой (1.5, 2.0, ...)
-- TEXT - текстовая строка (строка символов)
-- BLOB - двоичные данные (Binary Large Object)


-- 03. Маленькая таблица только для опыта с типами.
-- Имя типа в CREATE не гарантирует строгую проверку
CREATE TABLE IF NOT EXISTS demo_types (
    -- NOT NULL - значит ОБЯЗАТЕЛЬНО к заполнению
    lable TEXT NOT NULL,
    value
);

-- 04. Попробуем добавить данные в разных форматах и частичные данные
INSERT INTO demo_types (lable, value) 
VALUES
    ('целое число', 123),
    ('строка', 'текст'),
    ('число с плавающей точкой', 3.14),
    ('NULL значение', NULL);
   -- (NULL, 456); -- NOT NULL constraint failed: 

-- 05. typeof показывает РЕАЛЬНО сохранённый тип каждого значения.
SELECT lable, typeof(lable) as label_type, value, typeof(value) as value_type
FROM demo_types;

-- NULL — это отсутствие значения, а не пустая строка и не текст 'NULL'.
-- Поэтому сравнение через "= NULL" не работает: нужен IS NULL.
-- Числа и числа-в-кавычках в арифметике ведут себя похоже,
-- но текстовые значения превращаются в 0 — молча, без ошибки.

-- 06. Сложим числа и текст, чтобы увидеть результат.
SELECT lable, value, value + 1 AS value_plus
FROM demo_types;

-- DROP - удаляет таблицу
-- IF EXISTS - не выдаёт ошибку, если таблицы нет

DROP TABLE IF EXISTS demo_types;

-- 07. Создание таблицы для постов блога
DROP TABLE IF EXISTS posts;
CREATE TABLE posts (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    title TEXT NOT NULL,
    content TEXT NOT NULL,
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    likes INTEGER DEFAULT 0,
    views INTEGER DEFAULT 0
);

SELECT CURRENT_TIMESTAMP;

