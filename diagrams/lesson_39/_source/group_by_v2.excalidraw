      "boundElements": [],
      "updated": 0,
      "link": null,
      "locked": false,
      "text": "Два признака дают больше групп",
      "originalText": "Два признака дают больше групп",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
