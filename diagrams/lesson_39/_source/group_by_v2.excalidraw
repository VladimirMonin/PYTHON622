    },
    {
      "type": "text",
      "id": "rule-body",
      "x": 100,
      "y": 848,
      "width": 647,
      "height": 85.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "seed": 1,
      "version": 1,
      "versionNonce": 1,
      "index": null,
      "isDeleted": false,
      "groupIds": [],
      "frameId": null,
      "boundElements": [],
      "updated": 0,
      "link": null,
      "locked": false,
      "text": "Группа — это набор значений ключей, а не столбец.\n6 строк дали 5 групп: пара (hair, eye) повторилась только у Тора и Кэпа.\nГруппа из одной строки — тоже группа.",
      "originalText": "Группа — это набор значений ключей, а не столбец.\n6 строк дали 5 групп: пара (hair, eye) повторилась только у Тора и Кэпа.\nГруппа из одной строки — тоже группа.",
      "fontSize": 19,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.5
    },
    {
      "type": "text",
      "id": "s2-label",
      "x": 1010,
      "y": 178,
      "width": 425,
      "height": 32.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "seed": 1,
      "version": 1,
      "versionNonce": 1,
      "index": null,
      "isDeleted": false,
      "groupIds": [],
      "frameId": null,
      "boundElements": [],
      "updated": 0,
      "link": null,
      "locked": false,
      "text": "2 · GROUP BY hair — один признак",
      "originalText": "2 · GROUP BY hair — один признак",
      "fontSize": 26,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "type": "text",
      "id": "s2-sql",
      "x": 1012,
      "y": 208,
      "width": 592,
      "height": 47.6,
      "angle": 0,
      "strokeColor": "#1864ab",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "seed": 1,
      "version": 1,
      "versionNonce": 1,
      "index": null,
      "isDeleted": false,
      "groupIds": [],
      "frameId": null,
      "boundElements": [],
      "updated": 0,
      "link": null,
      "locked": false,
      "text": "SELECT hair, count(*), count(appearances), avg(appearances)\nFROM marvel GROUP BY hair;",
      "originalText": "SELECT hair, count(*), count(appearances), avg(appearances)\nFROM marvel GROUP BY hair;",
