    {
      "type": "text",
      "id": "note-body",
      "x": 100,
      "y": 630,
      "width": 611,
      "height": 85.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "seed": 1,
      "version": 1,
      "versionNonce": 1,
      "index": null,
      "isDeleted": false,
      "groupIds": [],
      "frameId": null,
      "boundElements": [],
      "updated": 0,
      "link": null,
      "locked": false,
      "text": "В группе «Блонд» appearances = NULL и 2000.\ncount(appearances) не считает NULL → 1.\navg(appearances) = 2000, а не 1000: NULL пропущен, а не обнулён.",
      "originalText": "В группе «Блонд» appearances = NULL и 2000.\ncount(appearances) не считает NULL → 1.\navg(appearances) = 2000, а не 1000: NULL пропущен, а не обнулён.",
      "fontSize": 19,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.5
    },
